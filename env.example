# Copy this file to .env before running `docker compose up`.
#
# It is named `env.example` and not `.env.example` on purpose: the workspace
# `.claudeignore` excludes every `.env.*` path, which would make the example
# unreadable to the assistants configured for this portfolio.
#
# Never put a real credential in this file.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=opensource_project_intelligence
POSTGRES_USER=opensource
POSTGRES_PASSWORD=opensource
POSTGRES_PORT=5433

# Consumed by the API, by the worker and by scripts/migrate.sh.
DATABASE_URL=postgres://opensource:opensource@postgres:5432/opensource_project_intelligence

# --- Application ------------------------------------------------------------
ENVIRONMENT=development
HTTP_ADDRESS=0.0.0.0:8100
API_PORT=8100
WEB_PORT=3100
VITE_API_BASE_URL=http://localhost:8100

# --- Worker -----------------------------------------------------------------
WORKER_INTERVAL=30s
WORKER_CONCURRENCY=4
SHUTDOWN_TIMEOUT=15s

# --- GitHub -----------------------------------------------------------------
# Read-only token. Never commit a real value.
GITHUB_TOKEN=

# --- Observability ----------------------------------------------------------
# Leave empty to keep OpenTelemetry instrumentation on without exporting.
OTEL_EXPORTER_OTLP_ENDPOINT=
