# Copy this file to .env before running `docker compose up`.
#
# It is named `env.example` and not `.env.example` on purpose: the workspace
# `.claudeignore` excludes every `.env.*` path, which would make the example
# unreadable to the assistants configured for this portfolio.
#
# Never put a real credential in this file.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=opensource_project_intelligence
POSTGRES_USER=opensource
POSTGRES_PASSWORD=opensource
POSTGRES_PORT=5433

# Consumed by the API, by the worker and by scripts/migrate.sh.
DATABASE_URL=postgres://opensource:opensource@postgres:5432/opensource_project_intelligence

# --- Durable delivery -------------------------------------------------------
JETSTREAM_ENABLED=true
NATS_URL=nats://nats:4222

# --- S3-compatible evidence storage ---------------------------------------
OBJECT_STORAGE_ENABLED=true
S3_ENDPOINT=http://object-storage:9000
S3_BUCKET=opensource-project-intelligence
S3_ACCESS_KEY=opensource
S3_SECRET_KEY=opensource-development-only

# --- Disposable acceleration ----------------------------------------------
VALKEY_ENABLED=true
VALKEY_URL=valkey://valkey:6379

# --- Application ------------------------------------------------------------
ENVIRONMENT=development
HTTP_ADDRESS=0.0.0.0:8100
API_PORT=8100
WEB_PORT=3100
VITE_API_BASE_URL=http://localhost:8100

# --- Worker -----------------------------------------------------------------
WORKER_INTERVAL=30s
WORKER_CONCURRENCY=4
SHUTDOWN_TIMEOUT=15s
EXPORT_CONCURRENCY=2

# --- Optional model and bounded assistant ----------------------------------
# Configure both values to enable model-backed capabilities. Credentials and
# provider endpoints are injected by the operator-owned adapter, never users.
AI_PROVIDER=
AI_MODEL=
AI_CONCURRENCY=4
ADK_MAX_STEPS=12
ADK_TIMEOUT=2m
ADK_MAX_OUTPUT_BYTES=65536
ADK_MAX_COST_MICROS=100000
ADK_TOOL_CONCURRENCY=1

# --- GitHub -----------------------------------------------------------------
# Read-only token. Never commit a real value.
GITHUB_TOKEN=

# --- Observability ----------------------------------------------------------
# Leave empty to keep OpenTelemetry instrumentation on without exporting.
OTEL_EXPORTER_OTLP_ENDPOINT=
